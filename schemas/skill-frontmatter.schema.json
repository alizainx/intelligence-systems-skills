{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IntelligenceSystemsSkillFrontmatter",
  "type": "object",
  "required": [
    "name",
    "description"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+){0,5}$",
      "maxLength": 64
    },
    "description": {
      "type": "string",
      "minLength": 20,
      "maxLength": 1024
    },
    "allowed-tools": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
